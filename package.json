{
	"name": "aura",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --silent",
		"lint": "prettier --check --cache . && eslint --cache --cache-location node_modules/.cache/eslint/ .",
		"format": "prettier --write --cache .",
		"test": "vitest run",
		"test:changed": "vitest run --changed",
		"test:e2e": "npm run build && playwright test",
		"test:e2e:changed": "playwright test --only-changed",
		"verifica": "npm run lint && npm run check && npm test && npm run test:e2e"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.6",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
