{
	admin off
	auto_https off
	persist_config off
}

# Intestazioni comuni, usate anche dalla pagina 404
(intestazioni) {
	header {
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		# il TLS lo termina il proxy di Railway: il sito è sempre in https. Niente preload né sottodomini
		Strict-Transport-Security "max-age=31536000"
		-Server
		# tutto ciò che non ha l'hash nel nome si rivalida sempre (HTML, service worker, manifest)
		?Cache-Control "no-cache"
	}
	# frame-ancestors non si può dare via <meta>: il resto della CSP è nell'HTML (kit.csp).
	# `?`: solo se non c'è già, così il service worker tiene la sua (sotto). In un blocco a parte:
	# più `?` nello stesso blocco valgono solo se mancano tutti
	header ?Content-Security-Policy "frame-ancestors 'none'"
}

# Nessuna direttiva `log`: niente access log.
:{$PORT:8080} {
	import intestazioni
	# cache lunga solo sui file con l'hash nel nome, e solo se esistono (un 404 qui non va in cache: vedi handle_errors)
	header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
	header /manifest.webmanifest Content-Type "application/manifest+json"
	# un worker non eredita la CSP della pagina (<meta>): la sua arriva solo da qui. Stessi limiti:
	# richieste e script solo verso questo sito
	header /service-worker.js Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'"
	# le pagine non hanno lo slash finale (/moduli, non /moduli/): stesso contenuto, un solo indirizzo
	@slash path_regexp slash ^(.+)/$
	redir @slash {re.slash.1}{?query} 308
	# statistiche anonime (docs/adr/0007-statistiche-anonime.md): al servizio sulla rete privata di
	# Railway. Senza gli header con l'IP del visitatore: il servizio non lo riceve proprio
	handle /statistiche/* {
		request_body {
			max_size 1KB
		}
		reverse_proxy {$STATISTICHE_HOST:127.0.0.1:9} {
			header_up -X-Forwarded-For
			header_up -X-Real-Ip
			header_up -X-Envoy-External-Address
			header_up -User-Agent
		}
	}
	root * /srv
	try_files {path} {path}.html {path}/index.html
	# .br/.gz generati in build; encode resta solo come ripiego per i file non precompressi
	encode zstd gzip
	file_server {
		precompressed br gzip
	}

	handle_errors 404 {
		import intestazioni
		# un errore non si mette mai in cache: durante un deploy il file può arrivare un attimo dopo
		header Cache-Control "no-store"
		rewrite * /404.html
		file_server {
			precompressed br gzip
		}
	}
}
